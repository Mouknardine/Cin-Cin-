# Sanity project — create one for free at https://www.sanity.io/manage
# Same project, two variable prefixes: NEXT_PUBLIC_ is read by the static
# site build, SANITY_STUDIO_ is read by the separate Studio (npm run
# studio:dev / studio:deploy). Fill in both with the same values.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2024-06-01

# Token with "Editor" rights, only needed to run scripts/seed.ts
SANITY_API_WRITE_TOKEN=
