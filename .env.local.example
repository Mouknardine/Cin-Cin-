# Sanity project — create one for free at https://www.sanity.io/manage
# Lu par le Studio (npm run studio:dev / studio:deploy) et par
# scripts/seed.ts. Le site lui-même ne lit pas ce fichier : son
# Project ID est écrit en dur dans assets/js/data.js (voir SANITY.md).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2024-06-01

# Token avec droits "Editor", seulement nécessaire pour lancer scripts/seed.ts
SANITY_API_WRITE_TOKEN=
